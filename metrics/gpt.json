    {
      "id": "26",
      "typ": "otwarte",
      "odpowiedz_user": "obrót, drgania, błędy w komponentach, błędy stanów i kolumn",
      "pewnosc": 0.55,
      "uwagi": "częściowo nieczytelne"
    },
    {
      "id": "27",
      "typ": "otwarte",
      "odpowiedz_user": "To układ zawierający czujniki, układ kondycjonowania sygnału i mikrokontroler w celu analizy i komunikacji, np. DS18B20 termometr",
      "pewnosc": 0.9,
      "uwagi": "czytelne"
    },
    {
      "id": "28",
      "typ": "otwarte",
      "odpowiedz_user": "Zestaw czujników robota. Stosuje się je, by maszyna mogła zbierać informacje o sobie i o otoczeniu",
      "pewnosc": 0.88,
      "uwagi": "czytelne"
    },
    {
      "id": "29",
      "typ": "otwarte",
      "odpowiedz_user": "Nowoczesne maszyny kroczące są szybkie i stabilne nawet w trudnym terenie. Są nawet bardziej stabilne, nie wymagają specjalnego środowiska laboratoryjnego, bo radzą sobie na terenie, przeszkodach i w terenie. Potrafią utrzymać stabilność nawet pomimo [nieczytelne] przez czujniki. Nowoczesne maszyny korzystają z manipulacji ręcznej i wykonują skomplikowane",
      "pewnosc": 0.52,
      "uwagi": "kilka fragmentów nieczytelnych"
    },
    {
      "id": "31",
      "typ": "otwarte",
      "odpowiedz_user": "Odometria – sposób wyznaczenia pozycji robota. Odometria czysta – jedynie pomiar ilości kroków bądź liczby wykonanych obrotów. Odometria rozszerzona – IMU plus odczyty z żyroskopu lub akcelerometru. Błędy: błąd odległości – suma kroków/liczby obrotów; błąd skrętu – różnica ilości kroków między kołami; ślizg – każde koło generuje inną wartość wynikającą z nierównej powierzchni. Jest to jedna z najprostszych metod, jednak z upływem czasu obserwowany dokładnie błędu. Błędy możemy podzielić na systematyczne (różnica wielkości kół) i przypadkowe (nierówność terenu).",
      "pewnosc": 0.8,
      "uwagi": "drobne nieczytelności, sens zachowany"
    },
    {
      "id": "32",
      "typ": "otwarte",
      "odpowiedz_user": "Metoda SLAM – to jednoczesna lokalizacja oraz mapowanie. Korzysta z odometrii. Robot, opuszczając punkt startowy, rysuje mapę oraz określa lokalizację i błędy redukują się po zamknięciu pętli i powrocie do znanego punktu. Korzystać może z kamer, laserów czy Kinecta.",
      "pewnosc": 0.93,
      "uwagi": "czytelne"
    }
